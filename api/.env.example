# Copy to .env and fill in the blank values:
#   cp .env.example .env
#   openssl rand -base64 48        # paste into JWT_SECRET
#
# .env is git-ignored. Never commit real credentials.

NODE_ENV=development
PORT=5050
HOST=0.0.0.0
LOG_LEVEL=debug

# Matches docker-compose.yml. Port 5435 avoids other local Postgres instances.
DATABASE_URL=postgresql://vela:vela_local_only@localhost:5435/vela?schema=public

# Required: 32+ characters, at least 12 distinct, not a placeholder.
JWT_SECRET=
JWT_ISSUER=vela-api
JWT_AUDIENCE=vela-client

# Exact origins, comma separated. https://*.example.com allows one subdomain label.
# The dashboard is served by the root app on 3030 (node server.js).
CORS_ORIGINS=http://localhost:3030

RATE_LIMIT_MAX=300
# Stricter limit for public booking routes (slots, holds, confirmations).
RATE_LIMIT_PUBLIC_MAX=60

# Platform Paystack account. Used for platform-mode checkout, bank lookups, and
# subaccounts. Without a key, development/test use a deterministic sandbox adapter
# (no network, no real money) and production refuses platform money routes with 501.
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE=https://api.paystack.co

# Required in production: 32 bytes, base64, used to seal merchant Paystack keys
# and full payout account numbers (AES-256-GCM).
#   openssl rand -base64 32
# Local development derives a throwaway key from JWT_SECRET when this is blank.
PAYMENT_ENCRYPTION_KEY=

# Register this URL in the platform Paystack dashboard AND in every merchant
# Paystack dashboard that connects in direct mode:
#   https://<api-host>/api/webhooks/paystack
BODY_LIMIT_BYTES=1048576
TRUST_PROXY=false
APP_VERSION=dev
