// Vela schema — Day 1 foundation (merchants, users, sessions, OTP, audit) and
// Day 2 identity/catalogue (merchant profile, services, portfolio).
// Constraints Prisma cannot express (partial/functional indexes, CHECKs,
// exclusion constraints) live in prisma/migrations and are covered by tests.
// Money is BIGINT kobo; timestamps are timestamptz in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  front_desk
  staff
  admin
}

enum UserStatus {
  invited
  active
  suspended
}

enum MerchantStatus {
  onboarding
  active
  suspended
  closed
}

enum OtpPurpose {
  verify_email
  login
  reset_password
  staff_invite
}

enum ServiceStatus {
  active
  archived
}

enum HoldStatus {
  active
  converted
  expired
  released
}

enum BookingStatus {
  confirmed
  cancelled
  completed
  no_show
}

enum BookingSource {
  online
  walk_in
}

enum AllocationKind {
  hold
  booking
}

enum PaymentProvider {
  paystack
}

// Where the money lands: the platform's Paystack account (split to the
// merchant's subaccount) or the merchant's own connected Paystack account.
enum PaymentMode {
  platform
  direct
}

enum PaymentConnectionStatus {
  active
  disabled
}

enum PaymentStatus {
  pending
  succeeded
  failed
  abandoned
  refunded
}

enum LedgerKind {
  charge
  refund
}

// A quote version moves draft -> sent -> accepted/declined. Sending a newer
// version retires the previous one as superseded, so an old link can never be
// accepted after the client has seen a revised price.
enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
  superseded
}

// A deposit (or full) invoice at acceptance; the balance invoice is issued once
// the deposit is paid.
enum InvoiceKind {
  deposit
  balance
  full
}

enum InvoiceStatus {
  open
  paid
  void
}

// A job starts as intake_pending only when an intake form is attached; with no
// form there is nothing for the client to submit, so it starts in progress.
enum JobStatus {
  intake_pending
  in_progress
  delivered
  cancelled
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  received
  queued
  sent
  delivered
  failed
}

enum AgentDraftStatus {
  pending
  approved
  rejected
  sent
  failed
}

model Merchant {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String         @db.VarChar(120)
  slug                   String         @unique @db.VarChar(63)
  trade                  String         @default("other") @db.VarChar(32)
  bio                    String?        @db.VarChar(1000)
  location               String?        @db.VarChar(200)
  phone                  String?        @db.VarChar(32)
  contactEmail           String?        @map("contact_email") @db.VarChar(320)
  customDomain           String?        @unique @map("custom_domain") @db.VarChar(253)
  customDomainVerifiedAt DateTime?      @map("custom_domain_verified_at") @db.Timestamptz(6)
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz(6)
  hasUnpublishedChanges  Boolean        @default(true) @map("has_unpublished_changes")
  inboxMode              String         @default("draft") @map("inbox_mode") @db.VarChar(16)
  timezone               String         @default("Africa/Lagos") @db.VarChar(64)
  currency               String         @default("NGN") @db.Char(3)
  leadTimeMinutes        Int            @default(0) @map("lead_time_minutes")
  slotIntervalMinutes    Int            @default(15) @map("slot_interval_minutes")
  holdTtlMinutes         Int            @default(15) @map("hold_ttl_minutes")
  status                 MerchantStatus @default(onboarding)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz(6)

  users                 User[]
  services              Service[]
  portfolioItems        PortfolioItem[]
  auditLogs             AuditLog[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  holds                 BookingHold[]
  bookings              Booking[]
  allocations           ResourceAllocation[]
  payments              Payment[]
  ledgerEntries         LedgerEntry[]
  paymentSettings       PaymentSettings?
  opportunities         Opportunity[]
  quotes                Quote[]
  invoices              Invoice[]
  jobs                  Job[]
  intakeTemplates       IntakeTemplate[]
  integration           MerchantIntegration?
  whatsappThreads       WhatsappThread[]
  whatsappMessages      WhatsappMessage[]
  agentDrafts           AgentDraft[]

  @@map("merchants")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String?    @map("merchant_id") @db.Uuid
  email           String     @db.VarChar(320)
  phone           String?    @db.VarChar(32)
  name            String     @db.VarChar(120)
  role            UserRole   @default(staff)
  status          UserStatus @default(invited)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  merchant              Merchant?              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  sessions              Session[]
  otpCodes              OtpCode[]
  services              Service[]              @relation("ServiceStaff")
  auditLogs             AuditLog[]             @relation("AuditActor")
  availabilityRules     AvailabilityRule[]     @relation("AvailabilityRuleStaff")
  availabilityOverrides AvailabilityOverride[] @relation("AvailabilityOverrideStaff")
  holds                 BookingHold[]          @relation("HoldStaff")
  bookings              Booking[]              @relation("BookingStaff")

  @@index([merchantId])
  @@index([email])
  @@map("users")
}

model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  familyId      String    @map("family_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ip            String?   @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  email       String     @db.VarChar(320)
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.Char(64)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  ip          String?    @db.VarChar(45)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt(sort: Desc)])
  @@map("otp_codes")
}

model Service {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String        @map("merchant_id") @db.Uuid
  name            String        @db.VarChar(120)
  description     String?       @db.VarChar(1000)
  durationMinutes Int           @map("duration_minutes")
  bufferMinutes   Int           @default(0) @map("buffer_minutes")
  priceKobo       BigInt        @map("price_kobo")
  depositKobo     BigInt        @default(0) @map("deposit_kobo")
  status          ServiceStatus @default(active)
  staffId         String?       @map("staff_id") @db.Uuid
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  staff          User?           @relation("ServiceStaff", fields: [staffId], references: [id], onDelete: SetNull)
  portfolioItems PortfolioItem[]
  holds          BookingHold[]
  bookings       Booking[]

  @@index([merchantId, status])
  @@index([staffId])
  @@map("services")
}

model PortfolioItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  serviceId  String?   @map("service_id") @db.Uuid
  title      String    @db.VarChar(120)
  caption    String?   @db.VarChar(300)
  imageUrl   String    @map("image_url") @db.VarChar(2048)
  isCover    Boolean   @default(false) @map("is_cover")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([merchantId, sortOrder])
  @@map("portfolio_items")
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @db.VarChar(320)
  ip        String?  @db.VarChar(45)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String?  @map("merchant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role") @db.VarChar(32)
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  actor    User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Weekly opening hours in the merchant's timezone. Minutes are offsets from
// local midnight, so a rule never shifts when a DST zone changes offset.
model AvailabilityRule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  staffId     String?  @map("staff_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staff    User?    @relation("AvailabilityRuleStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([merchantId, weekday])
  @@map("availability_rules")
}

// A single date that replaces the weekly rule: closed all day, or different
// hours. `date` is a local calendar date, not an instant.
model AvailabilityOverride {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  staffId     String?  @map("staff_id") @db.Uuid
  date        DateTime @db.Date
  closed      Boolean  @default(false)
  startMinute Int?     @map("start_minute")
  endMinute   Int?     @map("end_minute")
  reason      String?  @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staff    User?    @relation("AvailabilityOverrideStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([merchantId, date])
  @@map("availability_overrides")
}

// A short reservation of a resource while the customer pays. The matching
// `resource_allocations` row is what makes the slot unavailable.
model BookingHold {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String     @map("merchant_id") @db.Uuid
  serviceId  String     @map("service_id") @db.Uuid
  staffId    String?    @map("staff_id") @db.Uuid
  resourceId String     @map("resource_id") @db.Uuid
  startsAt   DateTime   @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime   @map("ends_at") @db.Timestamptz(6)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  status     HoldStatus @default(active)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    User?     @relation("HoldStaff", fields: [staffId], references: [id], onDelete: SetNull)
  booking  Booking?
  payments Payment[]

  @@index([merchantId, expiresAt])
  @@index([status, expiresAt])
  @@map("booking_holds")
}

model Booking {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId   String        @map("merchant_id") @db.Uuid
  serviceId    String        @map("service_id") @db.Uuid
  staffId      String?       @map("staff_id") @db.Uuid
  holdId       String?       @unique @map("hold_id") @db.Uuid
  resourceId   String        @map("resource_id") @db.Uuid
  reference    String        @unique @db.VarChar(24)
  clientName   String        @map("client_name") @db.VarChar(120)
  clientEmail  String?       @map("client_email") @db.VarChar(320)
  clientPhone  String?       @map("client_phone") @db.VarChar(32)
  notes        String?       @db.VarChar(1000)
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime      @map("ends_at") @db.Timestamptz(6)
  status       BookingStatus @default(confirmed)
  source       BookingSource @default(online)
  priceKobo    BigInt        @map("price_kobo")
  depositKobo  BigInt        @map("deposit_kobo")
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?       @map("cancel_reason") @db.VarChar(200)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    User?        @relation("BookingStaff", fields: [staffId], references: [id], onDelete: SetNull)
  hold     BookingHold? @relation(fields: [holdId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([merchantId, startsAt])
  @@index([merchantId, status])
  @@map("bookings")
}

// The serialization point for the booking race. `starts_at`/`ends_at` already
// include the service buffer, and the exclusion constraint in the migration
// makes a second overlapping row for the same resource impossible.
model ResourceAllocation {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String         @map("merchant_id") @db.Uuid
  resourceId String         @map("resource_id") @db.Uuid
  kind       AllocationKind
  holdId     String?        @unique @map("hold_id") @db.Uuid
  bookingId  String?        @unique @map("booking_id") @db.Uuid
  startsAt   DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime       @map("ends_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, startsAt])
  @@index([resourceId, startsAt])
  @@map("resource_allocations")
}

// One attempt to pay for one hold or booking. `reference` is ours and is what
// the provider echoes back, so the webhook never has to guess which row it is
// talking about.
model Payment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String          @map("merchant_id") @db.Uuid
  holdId            String?         @map("hold_id") @db.Uuid
  bookingId         String?         @map("booking_id") @db.Uuid
  invoiceId         String?         @map("invoice_id") @db.Uuid
  provider          PaymentProvider @default(paystack)
  // Pinned at initialize time so a webhook/refund uses the same credential
  // even if the merchant later switches settlement mode.
  settlementMode    PaymentMode     @default(platform) @map("settlement_mode")
  reference         String          @unique @db.VarChar(64)
  providerReference String?         @unique @map("provider_reference") @db.VarChar(100)
  amountKobo        BigInt          @map("amount_kobo")
  currency          String          @default("NGN") @db.Char(3)
  status            PaymentStatus   @default(pending)
  channel           String?         @db.VarChar(32)
  failureReason     String?         @map("failure_reason") @db.VarChar(200)
  authorizationUrl  String?         @map("authorization_url") @db.VarChar(2048)
  metadata          Json?
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  hold     BookingHold?   @relation(fields: [holdId], references: [id], onDelete: SetNull)
  booking  Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoice  Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  events   PaymentEvent[]
  ledger   LedgerEntry[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([holdId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

// One row per merchant: how they get paid and where money settles. Secret keys
// and full account numbers are AES-256-GCM ciphertext; only the last four and a
// fingerprint are stored in the clear for display.
model PaymentSettings {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId              String                  @unique @map("merchant_id") @db.Uuid
  mode                    PaymentMode             @default(platform)
  status                  PaymentConnectionStatus @default(active)
  secretKeyCiphertext     String?                 @map("secret_key_ciphertext") @db.Text
  secretKeyLast4          String?                 @map("secret_key_last4") @db.VarChar(8)
  secretKeyFingerprint    String?                 @map("secret_key_fingerprint") @db.VarChar(64)
  providerVerifiedAt      DateTime?               @map("provider_verified_at") @db.Timestamptz(6)
  subaccountCode          String?                 @map("subaccount_code") @db.VarChar(64)
  bankCode                String?                 @map("bank_code") @db.VarChar(8)
  bankName                String?                 @map("bank_name") @db.VarChar(80)
  accountName             String?                 @map("account_name") @db.VarChar(120)
  accountNumberCiphertext String?                 @map("account_number_ciphertext") @db.Text
  accountNumberLast4      String?                 @map("account_number_last4") @db.VarChar(8)
  bankVerifiedAt          DateTime?               @map("bank_verified_at") @db.Timestamptz(6)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("payment_settings")
}

// Every provider delivery is stored before it is acted on, with a unique
// provider event id so a retry can never duplicate a side effect.
model PaymentEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          PaymentProvider @default(paystack)
  eventId           String          @unique @map("event_id") @db.VarChar(120)
  type              String          @db.VarChar(64)
  payload           Json
  signatureVerified Boolean         @default(false) @map("signature_verified")
  processedAt       DateTime?       @map("processed_at") @db.Timestamptz(6)
  note              String?         @db.VarChar(200)
  receivedAt        DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)

  paymentId String?  @map("payment_id") @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([receivedAt(sort: Desc)])
  @@map("payment_events")
}

// A client enquiry that may or may not carry a date. `event_date` is a local
// calendar date; a project quote (photography, design) often has none, so the
// job it produces must not invent an appointment.
model Opportunity {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  title       String    @db.VarChar(160)
  clientName  String    @map("client_name") @db.VarChar(120)
  clientEmail String?   @map("client_email") @db.VarChar(320)
  clientPhone String?   @map("client_phone") @db.VarChar(32)
  notes       String?   @db.VarChar(2000)
  eventDate   DateTime? @map("event_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  quotes   Quote[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("opportunities")
}

// The stable identity of a quote; the price lives on immutable versions.
model Quote {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String      @map("merchant_id") @db.Uuid
  opportunityId String?     @map("opportunity_id") @db.Uuid
  clientName    String      @map("client_name") @db.VarChar(120)
  clientEmail   String?     @map("client_email") @db.VarChar(320)
  clientPhone   String?     @map("client_phone") @db.VarChar(32)
  currency      String      @default("NGN") @db.Char(3)
  status        QuoteStatus @default(draft)
  latestVersion Int         @default(0) @map("latest_version")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  versions    QuoteVersion[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status])
  @@map("quotes")
}

// Immutable once sent: editing a quote creates the next version. The share
// token is stored as a digest only, and only the holder can accept that exact
// version.
model QuoteVersion {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId            String      @map("quote_id") @db.Uuid
  version            Int
  status             QuoteStatus @default(draft)
  subtotalKobo       BigInt      @map("subtotal_kobo")
  totalKobo          BigInt      @map("total_kobo")
  depositPercent     Int         @map("deposit_percent")
  depositKobo        BigInt      @map("deposit_kobo")
  balanceKobo        BigInt      @map("balance_kobo")
  validUntil         DateTime    @map("valid_until") @db.Timestamptz(6)
  notes              String?     @db.VarChar(2000)
  terms              String?     @db.VarChar(2000)
  shareTokenHash     String?     @unique @map("share_token_hash") @db.Char(64)
  shareTokenIssuedAt DateTime?   @map("share_token_issued_at") @db.Timestamptz(6)
  sentAt             DateTime?   @map("sent_at") @db.Timestamptz(6)
  acceptedAt         DateTime?   @map("accepted_at") @db.Timestamptz(6)
  declinedAt         DateTime?   @map("declined_at") @db.Timestamptz(6)
  supersededAt       DateTime?   @map("superseded_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  quote    Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items    QuoteLineItem[]
  invoices Invoice[]
  job      Job?

  @@unique([quoteId, version])
  @@index([status, validUntil])
  @@map("quote_versions")
}

model QuoteLineItem {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId     String @map("version_id") @db.Uuid
  description   String @db.VarChar(200)
  quantity      Int    @default(1)
  unitPriceKobo BigInt @map("unit_price_kobo")
  totalKobo     BigInt @map("total_kobo")
  sortOrder     Int    @default(0) @map("sort_order")

  version QuoteVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, sortOrder])
  @@map("quote_line_items")
}

// An invoice is a number in the merchant's books, not a mutable price. Only the
// quote acceptance path creates one; the balance is created after the deposit
// clears. The public payment link is stored as a digest.
model Invoice {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId          String        @map("merchant_id") @db.Uuid
  quoteVersionId      String?       @map("quote_version_id") @db.Uuid
  kind                InvoiceKind
  status              InvoiceStatus @default(open)
  number              Int
  currency            String        @default("NGN") @db.Char(3)
  amountKobo          BigInt        @map("amount_kobo")
  paidKobo            BigInt        @default(0) @map("paid_kobo")
  clientName          String        @map("client_name") @db.VarChar(120)
  description         String        @db.VarChar(200)
  dueAt               DateTime?     @map("due_at") @db.Timestamptz(6)
  publicTokenHash     String?       @unique @map("public_token_hash") @db.Char(64)
  publicTokenIssuedAt DateTime?     @map("public_token_issued_at") @db.Timestamptz(6)
  issuedAt            DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt              DateTime?     @map("paid_at") @db.Timestamptz(6)
  voidedAt            DateTime?     @map("voided_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  quoteVersion QuoteVersion? @relation(fields: [quoteVersionId], references: [id], onDelete: SetNull)
  payments     Payment[]
  job          Job?

  @@unique([merchantId, number])
  @@unique([quoteVersionId, kind])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status])
  @@map("invoices")
}

// A reusable set of intake questions. Questions are validated by the API before
// they are stored; the JSON keeps template edits cheap.
model IntakeTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  title      String   @db.VarChar(120)
  questions  Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant    Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  jobs        Job[]
  submissions IntakeSubmission[]

  @@index([merchantId, updatedAt(sort: Desc)])
  @@map("intake_templates")
}

model Job {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId          String    @map("merchant_id") @db.Uuid
  quoteVersionId      String    @unique @map("quote_version_id") @db.Uuid
  invoiceId           String?   @unique @map("invoice_id") @db.Uuid
  intakeTemplateId    String?   @map("intake_template_id") @db.Uuid
  title               String    @db.VarChar(160)
  clientName          String    @map("client_name") @db.VarChar(120)
  clientEmail         String?   @map("client_email") @db.VarChar(320)
  clientPhone         String?   @map("client_phone") @db.VarChar(32)
  eventDate           DateTime? @map("event_date") @db.Date
  status              JobStatus @default(intake_pending)
  portalTokenHash     String?   @unique @map("portal_token_hash") @db.Char(64)
  portalTokenIssuedAt DateTime? @map("portal_token_issued_at") @db.Timestamptz(6)
  deliveredAt         DateTime? @map("delivered_at") @db.Timestamptz(6)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant       Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  quoteVersion   QuoteVersion      @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  invoice        Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  intakeTemplate IntakeTemplate?   @relation(fields: [intakeTemplateId], references: [id], onDelete: SetNull)
  submission     IntakeSubmission?

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status])
  @@map("jobs")
}

model IntakeSubmission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String   @unique @map("job_id") @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid
  answers     Json
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template IntakeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("intake_submissions")
}

// Append-only: the migration installs a trigger that rejects UPDATE and DELETE.
// Amounts are signed so a refund is a negative row, never a mutated charge.
model LedgerEntry {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String     @map("merchant_id") @db.Uuid
  paymentId  String?    @map("payment_id") @db.Uuid
  kind       LedgerKind
  amountKobo BigInt     @map("amount_kobo")
  currency   String     @default("NGN") @db.Char(3)
  memo       String?    @db.VarChar(200)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

// Messaging and the agent are opt-in per merchant. Tokens are sealed with the
// same AES-256-GCM key as payment credentials; only last4 is readable.
model MerchantIntegration {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId              String   @unique @map("merchant_id") @db.Uuid
  whatsappEnabled         Boolean  @default(false) @map("whatsapp_enabled")
  agentEnabled            Boolean  @default(false) @map("agent_enabled")
  whatsappPhoneNumberId   String?  @map("whatsapp_phone_number_id") @db.VarChar(64)
  whatsappTokenCiphertext String?  @map("whatsapp_token_ciphertext") @db.Text
  whatsappTokenLast4      String?  @map("whatsapp_token_last4") @db.VarChar(8)
  agentMonthlyDraftLimit  Int      @default(200) @map("agent_monthly_draft_limit")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_integrations")
}

// One conversation per merchant and WhatsApp id. An inbound STOP sets
// opted_out_at, and outbound code checks it before every send.
model WhatsappThread {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String    @map("merchant_id") @db.Uuid
  waId          String    @map("wa_id") @db.VarChar(32)
  clientName    String?   @map("client_name") @db.VarChar(120)
  lastInboundAt DateTime? @map("last_inbound_at") @db.Timestamptz(6)
  lastMessageAt DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  optedOutAt    DateTime? @map("opted_out_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  messages WhatsappMessage[]
  drafts   AgentDraft[]

  @@unique([merchantId, waId])
  @@index([merchantId, lastMessageAt(sort: Desc)])
  @@map("whatsapp_threads")
}

model WhatsappMessage {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String           @map("merchant_id") @db.Uuid
  threadId          String           @map("thread_id") @db.Uuid
  direction         MessageDirection
  status            MessageStatus
  providerMessageId String?          @unique @map("provider_message_id") @db.VarChar(120)
  body              String           @db.VarChar(4096)
  error             String?          @db.VarChar(200)
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  thread   WhatsappThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt(sort: Desc)])
  @@map("whatsapp_messages")
}

// The agent never sends directly: a draft waits for a human approval, and the
// approval is what writes the outbound message and the audit row.
model AgentDraft {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String           @map("merchant_id") @db.Uuid
  threadId   String?          @map("thread_id") @db.Uuid
  status     AgentDraftStatus @default(pending)
  goal       String           @db.VarChar(500)
  context    Json
  draftBody  String           @map("draft_body") @db.VarChar(2000)
  model      String           @db.VarChar(64)
  approvedBy String?          @map("approved_by") @db.Uuid
  approvedAt DateTime?        @map("approved_at") @db.Timestamptz(6)
  sentAt     DateTime?        @map("sent_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  thread   WhatsappThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("agent_drafts")
}
