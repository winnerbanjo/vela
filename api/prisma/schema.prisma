// Vela schema — Day 1 foundation (merchants, users, sessions, OTP, audit) and
// Day 2 identity/catalogue (merchant profile, services, portfolio).
// Constraints Prisma cannot express (partial/functional indexes, CHECKs,
// exclusion constraints) live in prisma/migrations and are covered by tests.
// Money is BIGINT kobo; timestamps are timestamptz in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  front_desk
  staff
  admin
}

enum UserStatus {
  invited
  active
  suspended
}

enum MerchantStatus {
  onboarding
  active
  suspended
  closed
}

enum OtpPurpose {
  verify_email
  login
  reset_password
  staff_invite
}

enum ServiceStatus {
  active
  archived
}

model Merchant {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String         @db.VarChar(120)
  slug                    String         @unique @db.VarChar(63)
  trade                   String         @default("other") @db.VarChar(32)
  bio                     String?        @db.VarChar(1000)
  location                String?        @db.VarChar(200)
  phone                   String?        @db.VarChar(32)
  contactEmail            String?        @map("contact_email") @db.VarChar(320)
  customDomain            String?        @unique @map("custom_domain") @db.VarChar(253)
  customDomainVerifiedAt  DateTime?      @map("custom_domain_verified_at") @db.Timestamptz(6)
  publishedAt             DateTime?      @map("published_at") @db.Timestamptz(6)
  hasUnpublishedChanges   Boolean        @default(true) @map("has_unpublished_changes")
  inboxMode               String         @default("draft") @map("inbox_mode") @db.VarChar(16)
  timezone                String         @default("Africa/Lagos") @db.VarChar(64)
  currency                String         @default("NGN") @db.Char(3)
  status                  MerchantStatus @default(onboarding)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?      @map("deleted_at") @db.Timestamptz(6)

  users          User[]
  services       Service[]
  portfolioItems PortfolioItem[]
  auditLogs      AuditLog[]

  @@map("merchants")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String?    @map("merchant_id") @db.Uuid
  email           String     @db.VarChar(320)
  phone           String?    @db.VarChar(32)
  name            String     @db.VarChar(120)
  role            UserRole   @default(staff)
  status          UserStatus @default(invited)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  merchant  Merchant?  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  sessions  Session[]
  otpCodes  OtpCode[]
  services  Service[]  @relation("ServiceStaff")
  auditLogs AuditLog[] @relation("AuditActor")

  @@index([merchantId])
  @@map("users")
}

model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  familyId      String    @map("family_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ip            String?   @db.VarChar(45)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  email       String     @db.VarChar(320)
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.Char(64)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  ip          String?    @db.VarChar(45)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt(sort: Desc)])
  @@map("otp_codes")
}

model Service {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String        @map("merchant_id") @db.Uuid
  name            String        @db.VarChar(120)
  description     String?       @db.VarChar(1000)
  durationMinutes Int           @map("duration_minutes")
  bufferMinutes   Int           @default(0) @map("buffer_minutes")
  priceKobo       BigInt        @map("price_kobo")
  depositKobo     BigInt        @default(0) @map("deposit_kobo")
  status          ServiceStatus @default(active)
  staffId         String?       @map("staff_id") @db.Uuid
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  staff    User?    @relation("ServiceStaff", fields: [staffId], references: [id], onDelete: SetNull)
  portfolioItems PortfolioItem[]

  @@index([merchantId, status])
  @@index([staffId])
  @@map("services")
}

model PortfolioItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String    @map("merchant_id") @db.Uuid
  serviceId  String?   @map("service_id") @db.Uuid
  title      String    @db.VarChar(120)
  caption    String?   @db.VarChar(300)
  imageUrl   String    @map("image_url") @db.VarChar(2048)
  isCover    Boolean   @default(false) @map("is_cover")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([merchantId, sortOrder])
  @@map("portfolio_items")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String?  @map("merchant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role") @db.VarChar(32)
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  actor    User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
