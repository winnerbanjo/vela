# ==============================================================================
# VELA CONNECTED APPS PLATFORM CONFIGURATION (.env.example)
# Grouped by provider and environment. Contains placeholders only.
# Variables marked [REQUIRED] must be configured in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & PUBLIC TUNNEL
# ------------------------------------------------------------------------------
# [REQUIRED] Publicly reachable HTTPS address for webhooks & OAuth redirects
# In local development, use an ngrok or Cloudflare tunnel URL (e.g., https://vela-local.ngrok-free.app)
VELA_PUBLIC_URL=http://localhost:3030
VELA_ENVIRONMENT=development
PORT=3030
SESSION_SECRET=replace_with_64_char_random_hex_for_session_encryption

# ------------------------------------------------------------------------------
# 2. PAYSTACK INTEGRATION (Nigeria & Ghana NGN/GHS Deposits)
# Doc: https://paystack.com/docs/api/
# ------------------------------------------------------------------------------
# [REQUIRED for Live NGN Deposits]
PAYSTACK_LIVE_PUBLIC_KEY=your_paystack_live_public_key_here
PAYSTACK_LIVE_SECRET_KEY=your_paystack_live_secret_key_here
PAYSTACK_LIVE_WEBHOOK_SECRET=your_paystack_live_webhook_secret_here

# [REQUIRED for Development Sandbox]
PAYSTACK_TEST_PUBLIC_KEY=your_paystack_test_public_key_here
PAYSTACK_TEST_SECRET_KEY=your_paystack_test_secret_key_here
PAYSTACK_TEST_WEBHOOK_SECRET=your_paystack_test_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. FLUTTERWAVE INTEGRATION (Multi-currency USD/GBP/EUR/NGN)
# Doc: https://developer.flutterwave.com/docs
# ------------------------------------------------------------------------------
FLUTTERWAVE_LIVE_PUBLIC_KEY=your_flutterwave_live_public_key_here
FLUTTERWAVE_LIVE_SECRET_KEY=your_flutterwave_live_secret_key_here
FLUTTERWAVE_LIVE_SECRET_HASH=your_flutterwave_live_secret_hash_here

FLUTTERWAVE_TEST_PUBLIC_KEY=your_flutterwave_test_public_key_here
FLUTTERWAVE_TEST_SECRET_KEY=your_flutterwave_test_secret_key_here
FLUTTERWAVE_TEST_SECRET_HASH=your_flutterwave_test_secret_hash_here

# ------------------------------------------------------------------------------
# 4. STRIPE CONNECT PLATFORM (Global Cards & Apple Pay / Google Pay)
# Doc: https://stripe.com/docs/connect
# ------------------------------------------------------------------------------
STRIPE_LIVE_PUBLISHABLE_KEY=your_stripe_live_publishable_key_here
STRIPE_LIVE_SECRET_KEY=your_stripe_live_secret_key_here
STRIPE_LIVE_WEBHOOK_SECRET=your_stripe_live_webhook_secret_here
STRIPE_CONNECT_CLIENT_ID=your_stripe_connect_client_id_here

STRIPE_TEST_PUBLISHABLE_KEY=your_stripe_test_publishable_key_here
STRIPE_TEST_SECRET_KEY=your_stripe_test_secret_key_here
STRIPE_TEST_WEBHOOK_SECRET=your_stripe_test_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. WHATSAPP BUSINESS & META GRAPH API
# Doc: https://developers.facebook.com/docs/whatsapp/cloud-api
# ------------------------------------------------------------------------------
# [REQUIRED for Studio Chat & Auto-Booking]
META_PLATFORM_APP_ID=xxxxxxxxxxxxxxxx
META_PLATFORM_APP_SECRET=replace_with_app_secret_from_meta_developer_console
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxxx
WHATSAPP_PERMANENT_ACCESS_TOKEN=replace_with_system_user_permanent_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_custom_verify_token_configured_in_meta

# ------------------------------------------------------------------------------
# 6. GOOGLE WORKSPACE (Google Calendar & Google Drive)
# Doc: https://developers.google.com/calendar/api/v3/reference
# ------------------------------------------------------------------------------
# [REQUIRED for Staff Calendar Availability]
GOOGLE_PLATFORM_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_PLATFORM_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_OAUTH_REDIRECT_URI=https://api.studioteni.ng/api/oauth/callback/google

# ------------------------------------------------------------------------------
# 7. MICROSOFT 365 (Outlook Calendar)
# Doc: https://learn.microsoft.com/en-us/graph/api/resources/calendar
# ------------------------------------------------------------------------------
MICROSOFT_PLATFORM_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_PLATFORM_CLIENT_SECRET=replace_with_azure_app_registration_secret
MICROSOFT_OAUTH_REDIRECT_URI=https://api.studioteni.ng/api/oauth/callback/microsoft

# ------------------------------------------------------------------------------
# 8. ZOHO SUITE (Zoho Mail, Zoho Books, Zoho CRM)
# Doc: https://www.zoho.com/developer/
# ------------------------------------------------------------------------------
ZOHO_PLATFORM_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_PLATFORM_CLIENT_SECRET=replace_with_client_secret_from_zoho_api_console
ZOHO_OAUTH_REDIRECT_URI=https://api.studioteni.ng/api/oauth/callback/zoho
ZOHO_DEFAULT_DATACENTER=zoho.com # Options: zoho.com (US), zoho.eu (EU), zoho.in (IN)

# ------------------------------------------------------------------------------
# 9. TIKTOK FOR BUSINESS (Direct Messaging API)
# Doc: https://developers.tiktok.com/docs/en/getting-started-overview
# ------------------------------------------------------------------------------
TIKTOK_PLATFORM_CLIENT_KEY=awxxxxxxxxxxxxxxxx
TIKTOK_PLATFORM_CLIENT_SECRET=replace_with_tiktok_developer_app_secret
TIKTOK_REDIRECT_URI=https://api.studioteni.ng/api/oauth/callback/tiktok

# ------------------------------------------------------------------------------
# 10. DROPBOX PLATFORM (Client Deliverables)
# Doc: https://www.dropbox.com/developers/documentation
# ------------------------------------------------------------------------------
DROPBOX_PLATFORM_APP_KEY=xxxxxxxxxxxxxxx
DROPBOX_PLATFORM_APP_SECRET=replace_with_dropbox_app_secret
DROPBOX_REDIRECT_URI=https://api.studioteni.ng/api/oauth/callback/dropbox
